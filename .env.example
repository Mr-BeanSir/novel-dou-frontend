# ===========================================
# Novel-Dou 前端环境变量配置
# ===========================================
#
# Next.js 环境判断规则：
#   next dev           → NODE_ENV=development → 加载 .env.development
#   next build / start → NODE_ENV=production  → 加载 .env.production
#
# 文件优先级（从低到高，同名变量后者覆盖前者）：
#   .env → .env.[环境] → .env.local → .env.[环境].local
#
# 使用方式：
#   开发环境: cp .env.example .env.development
#   生产环境: cp .env.example .env.production

# 服务端 API 地址（SSR 时使用，fetch 需要完整 URL）
# 浏览器端请求通过 nginx 反代走同域名，不需要此变量
SERVER_API_BASE_URL=http://localhost:8000/api

# 应用名称（预留，当前未使用）
NEXT_PUBLIC_APP_NAME=读书豆

# 应用 URL（预留，当前未使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000
